set -Eeuo pipefail

RVS_SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RVS_REPO_DIR=$(CDPATH= cd -- "$RVS_SCRIPT_DIR/.." && pwd)
RVS_ADB_BIN=${RVS_ADB_BIN:-adb}
RVS_SERIAL=""
RVS_YES=0
RVS_LOCALE="fr-FR"

usage() {
    printf '%s\n' \
        "Raspberry Voice Setup — compagnon ADB" \
        "" \
        "Usage: tools/rpi-voice-setup COMMANDE [options]" \
        "" \
        "Commandes:" \
        "  doctor              Diagnostic silencieux Pi/audio/Google" \
        "  install             Compiler, installer et ouvrir l'application" \
        "  set-language        Régler la locale Android (fr-FR par défaut)" \
        "  open-voice-match    Ouvrir les réglages Assistant" \
        "  prepare-enrollment  Libérer le listener HOTWORD isolé, avec garde-fous" \
        "  finish-enrollment   Réarmer et valider HOTWORD sur le micro USB" \
        "" \
        "Options:" \
        "  --serial SERIAL     Cible ADB explicite (IP:PORT ou identifiant mDNS)" \
        "  --locale LOCALE     Locale pour set-language" \
        "  --yes               Confirmer l'unique kill autorisé sans question" \
        "  -h, --help          Afficher cette aide"
}

die() {
    printf 'ERREUR: %s\n' "$*" >&2
    exit 1
}

require_adb() {
    command -v "$RVS_ADB_BIN" >/dev/null 2>&1 || die "adb est introuvable"
}

resolve_serial() {
    require_adb
    if [[ -n "$RVS_SERIAL" ]]; then
        "$RVS_ADB_BIN" -s "$RVS_SERIAL" get-state >/dev/null 2>&1 \
            || die "cible ADB indisponible: $RVS_SERIAL"
        return
    fi
    local devices count
    devices=$("$RVS_ADB_BIN" devices | awk 'NR>1 && $2 == "device" {print $1}')
    count=$(printf '%s\n' "$devices" | awk 'NF {count++} END {print count+0}')
    [[ "$count" -eq 1 ]] \
        || die "indiquez --serial: $count appareil(s) ADB prêt(s)"
    RVS_SERIAL=$(printf '%s\n' "$devices" | awk 'NF {print; exit}')
}

adb_target() {
    "$RVS_ADB_BIN" -s "$RVS_SERIAL" "$@"
}

adb_shell() {
    adb_target shell "$@"
}

try_adb_root() {
    adb_target root >/dev/null 2>&1 || true
    adb_target wait-for-device >/dev/null
}

sha_state() {
    local model=${1:-} sha=${2:-}
    case "$model:$sha" in
        *"Pi 4"*:a8c735ede091b92770cb74162baaa826c69708a26d7fce0d59d62b082d989ccc)
            printf 'Pi 4 corrigé et reconnu' ;;
        *"Pi 5"*:1781c9c08197fdcc789350c71c759b9cdfe085683a93dad206037375908af0ff)
            printf 'Pi 5 corrigé et reconnu' ;;
        *"Pi 4"*:27b5332e841f50e6b3435b5b512c86981443764e54a517262976bc98f0b587f3)
            printf 'Pi 4 stock reconnu' ;;
        *"Pi 5"*:ccf26258c38acdb741566023eefff0a2f288d807f69439904f08ac319b831f9a)
            printf 'Pi 5 stock reconnu' ;;
        *:a8c735ede091b92770cb74162baaa826c69708a26d7fce0d59d62b082d989ccc|\
        *:1781c9c08197fdcc789350c71c759b9cdfe085683a93dad206037375908af0ff|\
        *:27b5332e841f50e6b3435b5b512c86981443764e54a517262976bc98f0b587f3|\
        *:ccf26258c38acdb741566023eefff0a2f288d807f69439904f08ac319b831f9a)
            printf 'APEX connu mais incompatible avec ce modèle' ;;
        *:)
            printf 'illisible' ;;
        *)
            printf 'build inconnue — ne pas forcer un correctif' ;;
    esac
}

policy_state() {
    local model=${1:-} sha=${2:-}
    case "$model:$sha" in
        *"Pi 4"*:bb1c738411bd04e612cd5b907fef7674e34b9f939456f4fc33430f9b2b8153a9)
            printf 'Pi 4 corrigée et reconnue' ;;
        *"Pi 4"*:29d18b8e3ca51dc1f6e54fd39886a60e2372a9e1f610ae9d285311e312b732d5)
            printf 'Pi 4 stock reconnue' ;;
        *"Pi 5"*:*)
            printf 'non modifiée par le correctif Pi 5' ;;
        *:)
            printf 'illisible' ;;
        *)
            printf 'inconnue — vérifier la compatibilité' ;;
    esac
}

doctor() {
    resolve_serial
    local model fingerprint sdk locale apex_sha apex_label policy_sha policy_label
    model=$(adb_shell "(tr -d '\\000' </proc/device-tree/model) 2>/dev/null || getprop ro.product.model")
    fingerprint=$(adb_shell getprop ro.build.fingerprint | tr -d '\r')
    sdk=$(adb_shell getprop ro.build.version.sdk | tr -d '\r')
    locale=$(adb_shell 'value=$(cmd locale get-device-locale 2>/dev/null); case "$value" in ""|Unknown*) value=$(getprop persist.sys.locale); [ -n "$value" ] || value=$(getprop ro.product.locale); printf "%s\\n" "$value" ;; *) printf "%s\\n" "$value" ;; esac' | tr -d '\r')
    apex_sha=$(adb_shell 'sha256sum /vendor/apex/com.android.hardware.audio.rpi.apex 2>/dev/null | cut -d " " -f 1' | tr -d '\r')
    apex_label=$(sha_state "$model" "$apex_sha")
    policy_sha=$(adb_shell 'sha256sum /vendor/etc/usb_audio_policy_configuration.xml 2>/dev/null | cut -d " " -f 1' | tr -d '\r')
    policy_label=$(policy_state "$model" "$policy_sha")

    printf '%s\n' \
        "Cible: $RVS_SERIAL" \
        "Modèle: $model" \
        "Android API: $sdk" \
        "Locale: $locale" \
        "Fingerprint: $fingerprint" \
        "APEX audio: ${apex_sha:-indisponible}" \
        "État: $apex_label" \
        "Audio Policy USB: ${policy_sha:-indisponible}" \
        "État policy: $policy_label" \
        "" \
        "Entrées audio Android:"
    adb_shell 'dumpsys media.audio_policy 2>/dev/null' \
        | grep -E 'AUDIO_DEVICE_IN_USB|AUDIO_SOURCE_HOTWORD|sampling rate|channel mask' \
        | head -n 80 || true
    printf '\nÉtat Voice Interaction:\n'
    adb_shell 'dumpsys voiceinteraction 2>/dev/null' \
        | grep -E 'mPerformingSoftwareHotwordDetection|Hotword detection connection' \
        | head -n 20 || true
}

install_app() {
    resolve_serial
    (cd "$RVS_REPO_DIR" && ./gradlew :app:assembleDebug --no-daemon)
    local apk="$RVS_REPO_DIR/app/build/outputs/apk/debug/app-debug.apk"
    [[ -s "$apk" ]] || die "APK absente après compilation"
    adb_target install -r "$apk"
    adb_shell am start -n io.github.elkir0.rpivoicesetup/.MainActivity >/dev/null
    printf 'Application installée et ouverte sur %s\n' "$RVS_SERIAL"
}

set_language() {
    resolve_serial
    try_adb_root
    [[ "$RVS_LOCALE" =~ ^[a-z]{2,3}(-[A-Z]{2})?$ ]] || die "locale invalide: $RVS_LOCALE"
    adb_shell cmd locale set-device-locale "$RVS_LOCALE"
    printf 'Locale active: '
    adb_shell cmd locale get-device-locale
}

open_voice_match() {
    resolve_serial
    adb_shell am start -a com.google.android.googlequicksearchbox.action.ASSISTANT_SETTINGS >/dev/null
    printf 'Réglages Assistant ouverts. Allez dans « Hey Google et Voice Match ».\n'
}

prepare_enrollment() {
    resolve_serial
    try_adb_root
    local process_list matches count pid current_process_list current_matches current_count current_pid answer
    process_list=$(adb_shell 'ps -A -o USER,PID,PPID,ARGS')
    matches=$(printf '%s\n' "$process_list" | awk '
        $1 ~ /^u0_i/ && index($0, "com.google.android.googlequicksearchbox") \
            && index($0, "gsa.hot") {print}')
    count=$(printf '%s\n' "$matches" | awk 'NF {count++} END {print count+0}')
    [[ "$count" -eq 1 ]] \
        || die "refus de tuer: $count processus strictement admissible(s), attendu 1"
    pid=$(printf '%s\n' "$matches" | awk 'NR == 1 {print $2}')
    [[ "$pid" =~ ^[0-9]+$ ]] || die "PID invalide"
    printf 'Processus isolé admissible:\n%s\n' "$matches"
    if [[ "$RVS_YES" -ne 1 ]]; then
        printf 'Taper OUI pour libérer ce listener juste avant Réentraîner: '
        IFS= read -r answer
        [[ "$answer" == "OUI" ]] || die "annulé sans modification"
    fi

    current_process_list=$(adb_shell 'ps -A -o USER,PID,PPID,ARGS')
    current_matches=$(printf '%s\n' "$current_process_list" | awk '
        $1 ~ /^u0_i/ && index($0, "com.google.android.googlequicksearchbox") \
            && index($0, "gsa.hot") {print}')
    current_count=$(printf '%s\n' "$current_matches" | awk 'NF {count++} END {print count+0}')
    [[ "$current_count" -eq 1 ]] \
        || die "le listener a changé après confirmation; aucune action"
    current_pid=$(printf '%s\n' "$current_matches" | awk 'NR == 1 {print $2}')
    [[ "$current_pid" == "$pid" ]] \
        || die "le PID a changé après confirmation; aucune action"

    adb_shell kill -9 "$pid"
    printf '%s\n' \
        "Listener HOTWORD libéré." \
        "Touchez immédiatement Réentraîner dans Voice Match et prononcez les phrases."
}

finish_enrollment() {
    resolve_serial
    try_adb_root
    adb_shell cmd voiceinteraction restart-detection
    local state policy attempt
    for attempt in {1..15}; do
        state=$(adb_shell 'dumpsys voiceinteraction 2>/dev/null' || true)
        policy=$(adb_shell 'dumpsys media.audio_policy 2>/dev/null' || true)
        if grep -q 'mPerformingSoftwareHotwordDetection=true' <<<"$state" && \
                grep -q 'Source: 1999' <<<"$policy" && \
                grep -q 'AUDIO_DEVICE_IN_USB_DEVICE' <<<"$policy"; then
            printf '%s\n' \
                "OK: détection logicielle HOTWORD active sur le microphone USB." \
                "Testez maintenant « Hey Google », puis répétez après un redémarrage à froid."
            return 0
        fi
        sleep 1
    done
    printf 'État Voice Interaction après attente:\n%s\n' \
        "$(grep -E 'mPerformingSoftwareHotwordDetection|Hotword detection connection' <<<"$state" | head -n 20 || true)"
    printf '%s\n' \
        "HOTWORD USB non confirmé après 15 secondes." \
        "Relancez doctor et vérifiez le routage avant de tester la phrase." >&2
    return 1
}

[[ $# -gt 0 ]] || { usage; exit 2; }
RVS_COMMAND=$1
shift
while [[ $# -gt 0 ]]; do
    case "$1" in
        --serial) [[ $# -ge 2 ]] || die "valeur manquante pour --serial"; RVS_SERIAL=$2; shift 2 ;;
        --locale) [[ $# -ge 2 ]] || die "valeur manquante pour --locale"; RVS_LOCALE=$2; shift 2 ;;
        --yes) RVS_YES=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "option inconnue: $1" ;;
    esac
done

case "$RVS_COMMAND" in
    doctor) doctor ;;
    install) install_app ;;
    set-language) set_language ;;
    open-voice-match) open_voice_match ;;
    prepare-enrollment) prepare_enrollment ;;
    finish-enrollment) finish_enrollment ;;
    help|-h|--help) usage ;;
    *) usage; die "commande inconnue: $RVS_COMMAND" ;;
esac
