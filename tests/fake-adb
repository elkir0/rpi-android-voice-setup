#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${1:-} == "-s" ]]; then
    shift 2
fi

case ${1:-} in
    get-state)
        printf 'device\n'
        ;;
    root|wait-for-device)
        ;;
    shell)
        shift
        command_line="$*"
        case "$command_line" in
            *"/proc/device-tree/model"*)
                printf 'Raspberry Pi 4 Model B Rev 1.2\n'
                ;;
            "getprop ro.build.fingerprint")
                printf 'Raspberry/lineage_rpi4/rpi4:16/test:user/release-keys\n'
                ;;
            "getprop ro.build.version.sdk")
                printf '36\n'
                ;;
            *"cmd locale get-device-locale"*)
                printf 'fr-FR\n'
                ;;
            *"sha256sum /vendor/apex/com.android.hardware.audio.rpi.apex"*)
                if [[ ${RVS_FAKE_MODE:-none} == doctor-mismatch ]]; then
                    printf '1781c9c08197fdcc789350c71c759b9cdfe085683a93dad206037375908af0ff\n'
                else
                    printf 'a8c735ede091b92770cb74162baaa826c69708a26d7fce0d59d62b082d989ccc\n'
                fi
                ;;
            *"sha256sum /vendor/etc/usb_audio_policy_configuration.xml"*)
                printf 'bb1c738411bd04e612cd5b907fef7674e34b9f939456f4fc33430f9b2b8153a9\n'
                ;;
            *"dumpsys voiceinteraction"*)
                if [[ ${RVS_FAKE_MODE:-none} == finish-valid ]]; then
                    printf 'mPerformingSoftwareHotwordDetection=true\n'
                fi
                ;;
            *"dumpsys media.audio_policy"*)
                if [[ ${RVS_FAKE_MODE:-none} == finish-valid ]]; then
                    printf 'Source: 1999\nDevices: AUDIO_DEVICE_IN_USB_DEVICE\n'
                fi
                ;;
            "cmd voiceinteraction restart-detection")
                ;;
            "ps -A -o USER,PID,PPID,ARGS")
                printf 'USER PID PPID ARGS\n'
                case ${RVS_FAKE_MODE:-none} in
                    valid)
                        printf 'u0_i9004 4242 608 com.google.android.googlequicksearchbox:search:interactor:gsa.hot\n'
                        ;;
                    multiple)
                        printf '%s\n' \
                            'u0_i9004 4242 608 com.google.android.googlequicksearchbox:a:gsa.hot' \
                            'u0_i9005 4343 608 com.google.android.googlequicksearchbox:b:gsa.hot'
                        ;;
                    wrong-user)
                        printf 'shell 4242 608 com.google.android.googlequicksearchbox:search:gsa.hot\n'
                        ;;
                    race)
                        counter_file="${RVS_FAKE_LOG:?}.ps-count"
                        count=0
                        [[ -f "$counter_file" ]] && count=$(<"$counter_file")
                        if [[ "$count" -eq 0 ]]; then
                            printf 'u0_i9004 4242 608 com.google.android.googlequicksearchbox:search:gsa.hot\n'
                        else
                            printf 'u0_i9004 4343 608 com.google.android.googlequicksearchbox:search:gsa.hot\n'
                        fi
                        printf '%s\n' "$((count + 1))" > "$counter_file"
                        ;;
                    none) ;;
                    *) printf 'fixture inconnue\n' >&2; exit 3 ;;
                esac
                ;;
            "kill -9 4242")
                printf 'kill -9 4242\n' >> "${RVS_FAKE_LOG:?}"
                ;;
            *) ;;
        esac
        ;;
    *)
        printf 'commande fake-adb inattendue: %s\n' "$*" >&2
        exit 4
        ;;
esac
